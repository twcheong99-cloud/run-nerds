{
  "appId": "com.runnerds.app",
  "appName": "run-nerds",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "backgroundColor": "#050806",
      "showSpinner": false
    },
    "StatusBar": {
      "backgroundColor": "#06100a",
      "style": "DARK",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body"
    }
  }
}
